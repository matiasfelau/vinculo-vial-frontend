<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Requerido en runtime desde Android 13 (API 33): se pide recién después del login,
         con contexto de por qué se necesita. Ver NotificationPermissionRequester. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      La cámara es imprescindible: sin DNI ni selfie no hay validación de identidad.
      Se pide en runtime justo antes de abrir la captura, nunca al arrancar la app.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Se necesitan las dos cámaras: trasera para el DNI, frontal para la selfie. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".VinculoVialApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.VinculoVial">

        <!--
          Orientación fija: la captura de DNI y selfie se diseñó en vertical y girar el
          dispositivo en medio del proceso implicaría recapturar. Revisar cuando se
          integre CameraX real.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.VinculoVial"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.push.VvcMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
