<?xml version="1.0" encoding="utf-8"?>
<!--
  Zero Retention también a nivel plataforma: nada de esta app se respalda
  en la nube ni se transfiere entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
