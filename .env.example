# Equivalente a local.properties.example para entornos CI (mismos nombres de clave).
# Gradle lee estas variables de entorno cuando no existe local.properties.
API_BASE_URL=http://10.0.2.2:8080/
IDENTITY_HPKE_PUBLIC_KEY=vqY0RUzHxXbMXIDaHErJhtrf6Yo/wcnUAq52OE5Ti3c=
# US-08: pública X25519 (base64) de vinculo-vial-ia; cifra las fotos de evidencia de las alertas.
IA_HPKE_PUBLIC_KEY=
# CI no tiene Play Store: ahí corresponde el modo mock.
ATTESTATION_MODE=mock
APP_ATTESTATION_PSK=dev-shared-attestation-psk-change-me
ATTESTATION_TOKEN_TTL_SECONDS=60
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
NETWORK_TIMEOUT_MS=15000
# US-13: segundos de la cuenta regresiva del botón "Reenviar" del código por email. Tiene que
# coincidir con EMAIL_CODE_RESEND_SECONDS de Identity, que es quien aplica el throttle.
EMAIL_CODE_RESEND_SECONDS=60
# US-12: segundos en segundo plano tras los cuales la sesión se bloquea al volver a primer plano.
SESSION_LOCK_AFTER_BACKGROUND_SECONDS=300
