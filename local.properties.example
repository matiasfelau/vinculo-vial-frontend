# Copiar a `local.properties` (gitignored) y completar.
# Gradle lo consume en app/build.gradle.kts y lo expone via BuildConfig.
# En CI, las mismas claves pueden inyectarse como variables de entorno.

sdk.dir=C:\\Users\\<usuario>\\AppData\\Local\\Android\\Sdk

# Base URL del Gateway (emulador Android -> host local = 10.0.2.2)
API_BASE_URL=http://10.0.2.2:8080/

# Public Key X25519 (raw, base64) de vinculo-vial-identity.
# Debe ser el par de IDENTITY_HPKE_PRIVATE_KEY en el repo de Identity.
# Par de desarrollo generado para este proyecto:
#   public : vqY0RUzHxXbMXIDaHErJhtrf6Yo/wcnUAq52OE5Ti3c=
#   private: wdLs3faGgrCj4K9qTTi44p/vaafkCRXK0bQwsxJyVd0=   <- va en Identity, NO en la app
IDENTITY_HPKE_PUBLIC_KEY=vqY0RUzHxXbMXIDaHErJhtrf6Yo/wcnUAq52OE5Ti3c=

# Public Key X25519 (raw, base64) de vinculo-vial-vehicle. Par nuevo de US-04, distinto del
# de Identity: la patente se cifra contra Vehicle, el DNI sigue cifrándose contra Identity
# (cifrado diferenciado -- ver HpkeEncryptor). Debe ser el par de
# VEHICLE_HPKE_PRIVATE_KEY en el repo de Vehicle; no hay un valor de desarrollo
# pre-generado acá porque ese par vive coordinado con ese repo.
VEHICLE_HPKE_PUBLIC_KEY=

# Modo de attestation: `play_integrity` (default) o `mock`.
# IMPORTANTE: el Gateway tiene que validar de la misma forma que la app.
#   play_integrity  -> el token lo emite Google y el Gateway lo decodifica llamando a la
#                      Play Integrity API con una cuenta de servicio del mismo proyecto.
#   mock            -> el Gateway verifica el HMAC con APP_ATTESTATION_PSK.
# Cualquier valor que no sea exactamente `mock` se interpreta como play_integrity: un
# typo no debe degradar la seguridad en silencio.
ATTESTATION_MODE=play_integrity

# Sólo para ATTESTATION_MODE=play_integrity.
# Número de proyecto de Google Cloud vinculado a la app en Play Console
# (Play Console > Configuración > Integridad de la app; es un número, no el project ID).
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=

# Sólo para ATTESTATION_MODE=mock (emuladores y CI, donde no hay Play Store).
# PSK de desarrollo compartida con vinculo-vial-gateway (mínimo 32 bytes).
APP_ATTESTATION_PSK=dev-shared-attestation-psk-change-me
ATTESTATION_TOKEN_TTL_SECONDS=60

NETWORK_TIMEOUT_MS=15000
